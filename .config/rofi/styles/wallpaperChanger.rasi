@theme "theme.rasi"


window {
    width: 80%;
    margin: 6px 6px 0 6px;
    location: south;
    anchor: south;
    border-radius: 8px 8px 0 0;
    border: 2px 2px 0 2px;
}

configuration {
    kb-move-char-back: "Control+b";
    kb-move-char-forward: "Control+f";
    kb-row-up: "Up,Left";
    kb-row-down: "Down,Right";
}

entry {
    placeholder: "Select wallpaper";
}

textbox-prompt-colon {
    str: "󰸉";
}

listview {
    columns: 4;
    lines: 1;
    scrollbar: false;
}

element {
    orientation: vertical;
    children: [ element-icon, element-text ];
    cursor: pointer;
    spacing: 0px;
}

element-icon {
    size: 240px;
    cursor: inherit;
}

element-text {
    horizontal-align: 0.5;
    cursor: inherit;
}
