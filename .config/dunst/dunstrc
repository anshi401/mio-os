# Generated with matugen

[global]
follow = mouse
width = 480
origin = top-center
offset = (16, 16)
dmenu = rofi -dmenu -config "~/.mio-os/.config/rofi/styles/notificationMenu.rasi"
icon_theme = "Papirus-Dark"
enable_recursive_icon_lookup = true
font = CodeNewRoman Nerd Font Propo 12
notification_limit = 4
progress_bar = true
progress_bar_height = 16
progress_bar_frame_width = 2
progress_bar_min_width = 0
progress_bar_max_width = 480
progress_bar_corner_radius = 4
indicate_hidden = yes
separator_height = 1
padding = 16
horizontal_padding = 16
text_icon_padding = 16
frame_width = 2
line_height = 0
corner_radius = 8
alignment = left
vertical_alignment = center
sort = yes
markup = full
show_age_threshold = 60
ellipsize = middle
ignore_newline = no
stack_duplicates = true
hide_duplicate_count = false
show_indicators = yes
icon_position = left
min_icon_size = 32
max_icon_size = 32
sticky_history = yes
history_length = 20
browser = /usr/bin/xdg-open
always_run_script = true
title = Dunst
class = Dunst
ignore_dbusclose = false
force_xwayland = false
force_xinerama = false
mouse_left_click = context, close_current
mouse_middle_click = close_current
mouse_right_click = close_all
frame_color = "#504349"
highlight = "#fcb0d7"
separator_color= "#504349"
gap_size = 5

[experimental]
per_monitor_dpi = false

[urgency_low]
timeout = 3
background = "#181115CC"
foreground = "#eddfe3"
highlight = "#fcb0d7"

[urgency_normal]
timeout = 6
background = "#181115CC"
foreground = "#eddfe3"
highlight = "#fcb0d7"

[urgency_critical]
timeout = 0
background = "#181115CC"
foreground = "#eddfe3"
highlight = "#ffb4ab"
frame_color = "#ffb4ab"
