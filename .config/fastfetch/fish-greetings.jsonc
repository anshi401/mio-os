{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "file",
    "source": "~/.config/fastfetch/logo.txt",
    "color": {
      "1": "white",
      "2": "90"
    },
    "padding": {
      "top": 2,
      "left": 2,
      "right": 4
    }
  },
  "display": {
    "separator": " ",
    "color": { "keys": "blue" }
  },
  "modules": [
    {
      "type": "custom",
      "format": "╭──────────────────────────────────╮",
      "outputColor": "90"
    },
    "break",
    {
      "type": "packages",
      "key": "  󰏗"
    },
    {
      "type": "memory",
      "key": "  "
    },
    {
      "type": "disk",
      "key": "  ",
      "format": "{size-used} / {size-total} ({size-percentage})"
    },
    {
      "type": "disk",
      "key": "  󰃭",
      "folders": "/",
      "format": "{days} days"
    },
    {
      "type": "uptime",
      "key": "  󰅐"
    },
    "break",
    {
      "type": "custom",
      "format": "╰──────────────────────────────────╯",
      "outputColor": "90"
    },
    "break"
  ]
}
